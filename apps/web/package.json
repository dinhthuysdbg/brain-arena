{
  "name": "@brain-arena/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "esbuild src/main.tsx --bundle --format=esm --target=es2020 --jsx=automatic --minify --define:process.env.NODE_ENV='\"production\"' --loader:.ts=ts --loader:.tsx=tsx --outfile=dist/app.js && cp index.html dist/index.html",
    "dev": "npm run build -- --sourcemap && esbuild src/main.tsx --bundle --format=esm --jsx=automatic --loader:.ts=ts --loader:.tsx=tsx --outfile=dist/app.js --define:process.env.NODE_ENV='\"development\"' --sourcemap --watch --servedir=dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "preview": "npx --yes serve dist"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
